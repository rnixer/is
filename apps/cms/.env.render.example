# Notes for Render Environment. Not loaded by local development.
# Copy to .env.render and fill values there. Never commit the filled file.
# Paste these variables into Render > Environment, or use its import feature.
NODE_ENV=production
NODE_VERSION=24.18.0
HOST=0.0.0.0
# Do not set PORT: Render supplies it.

# Supabase > Connect > Session pooler (IPv4), not Transaction pooler.
DATABASE_CLIENT=postgres
# Supabase > Connect > Session pooler URI. Use URL OR separate fields below.
# Replace [YOUR-PASSWORD]; URL-encode special characters in the password.
# Leave URL empty to use the separate fields. Keep SSL/CA settings below.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true
# Supabase Database settings > server root certificate.
# Replace the placeholder with the complete PEM, preserving actual newlines.
DATABASE_SSL_CA=
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# Copy generated values from Render Blueprint after creation. Keep them stable.
# When importing this file, fill these first; never overwrite existing secrets with blanks.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
STOREFRONT_TOKEN=
STOREFRONT_URL=https://is-mix14.vercel.app
# Optional: Render sets RENDER_EXTERNAL_URL automatically.
# PUBLIC_URL=https://YOUR-SERVICE.onrender.com

# Supabase Storage: create a public product-images bucket.
UPLOAD_PROVIDER=aws-s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=product-images
# https://PROJECT_REF.supabase.co/storage/v1/object/public/product-images
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Test keys only for now. Webhook secret must belong to the Render endpoint.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRAPI_TELEMETRY_DISABLED=true
